# Orchard Growers AI lead collector (backend only)
GOOGLE_PROGRAMMABLE_SEARCH_API_KEY=
GOOGLE_CX_GROWERS=
GOOGLE_CX_BUYERS=
GOOGLE_CX_EXPORTERS=
GOOGLE_CX_MARKETS=
GOOGLE_CX_RESEARCH=
