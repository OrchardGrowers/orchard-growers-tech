NODE_ENV=production
APP_ENV=production
PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=

CLIENT_URL=https://orchardgrowers.in
ORCHARD_FRONTEND_URL=https://orchardgrowers.in
ADMIN_URL=https://admins.orchardgrowers.in
ADMIN_FRONTEND_URL=https://admins.orchardgrowers.in
EFRUITMANDI_URL=https://efruitmandi.live
EFRUITMANDI_FRONTEND_URL=https://efruitmandi.live
EFRUITMANDI_CLIENT_URL=https://efruitmandi.live
ORCHARDGROWERS_CLIENT_URL=https://orchardgrowers.in
ORCHARD_API_URL=https://api.orchardgrowers.in
EFRUITMANDI_API_URL=https://api.efruitmandi.live
ALLOWED_ORIGINS=https://orchardgrowers.in,https://www.orchardgrowers.in,https://efruitmandi.live,https://www.efruitmandi.live,https://admins.orchardgrowers.in
CORS_ORIGINS=https://orchardgrowers.in,https://www.orchardgrowers.in,https://efruitmandi.live,https://www.efruitmandi.live,https://admins.orchardgrowers.in

# Payment gateway availability and Cashfree PG credentials.
# Keep credentials on backend only. Use sandbox until live merchant credentials are approved.
PAYMENT_PARTNER_ENABLED=false
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Optional local-only simulator when credentials are absent. Keep false in production.
CASHFREE_ALLOW_TEST_MODE=false

# OAuth credentials. Use callback URLs matching the live backend domain and local backend.
# Google OAuth redirect URIs:
# Orchard: https://api.orchardgrowers.in/api/auth/orchard/google/callback
# eFruitMandi: https://api.efruitmandi.live/api/auth/efruitmandi/google/callback
GOOGLE_CLIENT_ID_ORCHARD=
GOOGLE_CLIENT_SECRET_ORCHARD=
GOOGLE_CLIENT_ID_EFRUITMANDI=
GOOGLE_CLIENT_SECRET_EFRUITMANDI=
GOOGLE_CALLBACK_URL=
GOOGLE_CALLBACK_URL_ORCHARD=https://api.orchardgrowers.in/api/auth/orchard/google/callback
GOOGLE_CALLBACK_URL_EFRUITMANDI=https://api.efruitmandi.live/api/auth/efruitmandi/google/callback
FACEBOOK_APP_ID_ORCHARD=
FACEBOOK_APP_SECRET_ORCHARD=
FACEBOOK_APP_ID_EFRUITMANDI=
FACEBOOK_APP_SECRET_EFRUITMANDI=
FACEBOOK_CALLBACK_URL=
FACEBOOK_CALLBACK_URL_ORCHARD=https://api.orchardgrowers.in/api/auth/orchard/facebook/callback
FACEBOOK_CALLBACK_URL_EFRUITMANDI=https://api.efruitmandi.live/api/auth/efruitmandi/facebook/callback
FACEBOOK_GRAPH_VERSION=v25.0

# Cloudinary server-side uploads for Admin Panel product images.
# Keep these only on the backend environment.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_FOLDER=orchard-growers/products
CLOUDINARY_LOT_FOLDER=efruitmandi/lots

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_DEBUG=false
EMAIL_PROVIDER=smtp
BREVO_API_KEY=

ORCHARD_SMTP_USER=no-reply@orchardgrowers.in
ORCHARD_SMTP_PASS=
ORCHARD_SMTP_FROM="Orchard Growers <no-reply@orchardgrowers.in>"
ORCHARD_RESET_FROM="Orchard Growers Password Reset <reset-password@orchardgrowers.in>"
ORCHARD_SUPPORT_EMAIL=support@orchardgrowers.in

EFRUITMANDI_SMTP_USER=no-reply@efruitmandi.live
EFRUITMANDI_SMTP_PASS=
EFRUITMANDI_SMTP_FROM="eFruitMandi <no-reply@efruitmandi.live>"
EFRUITMANDI_RESET_FROM="eFruitMandi Password Reset <no-reply@efruitmandi.live>"
EFRUITMANDI_SUPPORT_EMAIL=support@efruitmandi.live

ALLOW_TEST_OTP=false
TEST_OTP=
OTP_EXPIRY_MINUTES=5

