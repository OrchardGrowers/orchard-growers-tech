NODE_ENV=production
APP_ENV=production
PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=

CLIENT_URL=https://orchardgrowers.in
ADMIN_URL=https://admins.orchardgrowers.in
ADMIN_FRONTEND_URL=https://admins.orchardgrowers.in
EFRUITMANDI_URL=https://efruitmandi.live
EFRUITMANDI_CLIENT_URL=https://efruitmandi.live
ORCHARDGROWERS_CLIENT_URL=https://orchardgrowers.in
ALLOWED_ORIGINS=
CORS_ORIGINS=

# OAuth credentials. Use callback URLs matching the live backend domain and local backend.
# Google OAuth redirect URI:
# Local: http://localhost:5000/api/auth/google/callback
# Live: https://YOUR_BACKEND_DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID_ORCHARD=
GOOGLE_CLIENT_SECRET_ORCHARD=
GOOGLE_CLIENT_ID_EFRUITMANDI=
GOOGLE_CLIENT_SECRET_EFRUITMANDI=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GOOGLE_CALLBACK_URL_ORCHARD=
GOOGLE_CALLBACK_URL_EFRUITMANDI=
FACEBOOK_APP_ID_ORCHARD=
FACEBOOK_APP_SECRET_ORCHARD=
FACEBOOK_APP_ID_EFRUITMANDI=
FACEBOOK_APP_SECRET_EFRUITMANDI=
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback
FACEBOOK_CALLBACK_URL_ORCHARD=
FACEBOOK_CALLBACK_URL_EFRUITMANDI=
FACEBOOK_GRAPH_VERSION=v25.0

# Cloudinary server-side uploads for Admin Panel product images.
# Keep these only on the backend environment.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_FOLDER=orchard-growers/products

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_DEBUG=false

ORCHARD_SMTP_USER=no-reply@orchardgrowers.in
ORCHARD_SMTP_PASS=
ORCHARD_SMTP_FROM="Orchard Growers <no-reply@orchardgrowers.in>"
ORCHARD_RESET_FROM="Orchard Growers Password Reset <reset-password@orchardgrowers.in>"
ORCHARD_SUPPORT_EMAIL=support@orchardgrowers.in

EFRUITMANDI_SMTP_USER=no-reply@efruitmandi.live
EFRUITMANDI_SMTP_PASS=
EFRUITMANDI_SMTP_FROM="eFruitMandi <no-reply@efruitmandi.live>"
EFRUITMANDI_RESET_FROM="eFruitMandi Password Reset <no-reply@efruitmandi.live>"
EFRUITMANDI_SUPPORT_EMAIL=support@efruitmandi.live

ALLOW_TEST_OTP=false
TEST_OTP=
OTP_EXPIRY_MINUTES=5

MOBILE_OTP_PROVIDER=MSG91
USE_LEGACY_MSG91_API=false

ORCHARD_MSG91_AUTH_KEY=
ORCHARD_MSG91_TEMPLATE_ID=
ORCHARD_MSG91_SENDER_ID=

EFRUITMANDI_MSG91_AUTH_KEY=
EFRUITMANDI_MSG91_TEMPLATE_ID=
EFRUITMANDI_MSG91_SENDER_ID=

MSG91_OTP_LENGTH=6
MSG91_OTP_EXPIRY_MINUTES=5

TWO_FACTOR_API_KEY=
TWO_FACTOR_TEMPLATE_NAME=

MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=
ADMIN_RESET_BASE_URL=
# Optional: seed an initial admin on first startup (created only if missing)
ADMIN_SEED_EMAIL=pawann@orchardgrowers.in
ADMIN_SEED_ROLE=superadmin
ADMIN_SEED_STATUS=active
