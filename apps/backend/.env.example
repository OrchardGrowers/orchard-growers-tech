NODE_ENV=production
APP_ENV=production
PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=

# Development only. When set to production, explicitly marked public marketplace GETs
# are fetched by the local backend from the production public API and re-sanitized.
# Ignored whenever NODE_ENV=production. Keep local (or unset) for normal local MongoDB mode.
DEV_PUBLIC_MARKETPLACE_SOURCE=local
# Optional dedicated secret for opaque development-only public entity references.
# JWT_SECRET is used when this is blank.
DEV_PUBLIC_MARKETPLACE_ID_SECRET=

CLIENT_URL=https://orchardgrowers.in
ORCHARD_FRONTEND_URL=https://orchardgrowers.in
ADMIN_URL=https://admins.orchardgrowers.in
ADMIN_FRONTEND_URL=https://admins.orchardgrowers.in
EFRUITMANDI_URL=https://efruitmandi.live
EFRUITMANDI_FRONTEND_URL=https://efruitmandi.live
EFRUITMANDI_CLIENT_URL=https://efruitmandi.live
ORCHARDGROWERS_CLIENT_URL=https://orchardgrowers.in
ORCHARD_API_URL=https://api.orchardgrowers.in
EFRUITMANDI_API_URL=https://api.efruitmandi.live
ALLOWED_ORIGINS=https://orchardgrowers.in,https://www.orchardgrowers.in,https://efruitmandi.live,https://www.efruitmandi.live,https://admins.orchardgrowers.in
CORS_ORIGINS=https://orchardgrowers.in,https://www.orchardgrowers.in,https://efruitmandi.live,https://www.efruitmandi.live,https://admins.orchardgrowers.in

# Payment gateway availability and Cashfree PG credentials.
# Keep credentials on backend only. Use sandbox until live merchant credentials are approved.
PAYMENT_PARTNER_ENABLED=false
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Optional local-only simulator when credentials are absent. Keep false in production.
CASHFREE_ALLOW_TEST_MODE=false

# OAuth credentials. Use callback URLs matching the live backend domain and local backend.
# Google OAuth redirect URIs:
# Orchard: https://api.orchardgrowers.in/api/auth/orchard/google/callback
# eFruitMandi: https://api.efruitmandi.live/api/auth/efruitmandi/google/callback
GOOGLE_CLIENT_ID_ORCHARD=
GOOGLE_CLIENT_SECRET_ORCHARD=
GOOGLE_CLIENT_ID_EFRUITMANDI=
GOOGLE_CLIENT_SECRET_EFRUITMANDI=
GOOGLE_CALLBACK_URL=
GOOGLE_CALLBACK_URL_ORCHARD=https://api.orchardgrowers.in/api/auth/orchard/google/callback
GOOGLE_CALLBACK_URL_EFRUITMANDI=https://api.efruitmandi.live/api/auth/efruitmandi/google/callback
FACEBOOK_APP_ID_ORCHARD=
FACEBOOK_APP_SECRET_ORCHARD=
FACEBOOK_APP_ID_EFRUITMANDI=
FACEBOOK_APP_SECRET_EFRUITMANDI=
FACEBOOK_CALLBACK_URL=
FACEBOOK_CALLBACK_URL_ORCHARD=https://api.orchardgrowers.in/api/auth/orchard/facebook/callback
FACEBOOK_CALLBACK_URL_EFRUITMANDI=https://api.efruitmandi.live/api/auth/efruitmandi/facebook/callback
FACEBOOK_GRAPH_VERSION=v25.0

# Cloudinary server-side uploads for Admin Panel product images.
# Keep these only on the backend environment.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_FOLDER=orchard-growers/products
CLOUDINARY_LOT_FOLDER=efruitmandi/lots

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_DEBUG=false
EMAIL_PROVIDER=smtp
BREVO_API_KEY=

ORCHARD_SMTP_USER=no-reply@orchardgrowers.in
ORCHARD_SMTP_PASS=
ORCHARD_SMTP_FROM="Orchard Growers <no-reply@orchardgrowers.in>"
ORCHARD_RESET_FROM="Orchard Growers Password Reset <reset-password@orchardgrowers.in>"
ORCHARD_SUPPORT_EMAIL=support@orchardgrowers.in

EFRUITMANDI_SMTP_USER=no-reply@efruitmandi.live
EFRUITMANDI_SMTP_PASS=
EFRUITMANDI_SMTP_FROM="eFruitMandi <no-reply@efruitmandi.live>"
EFRUITMANDI_RESET_FROM="eFruitMandi Password Reset <no-reply@efruitmandi.live>"
EFRUITMANDI_SUPPORT_EMAIL=support@efruitmandi.live

# Isolated Admin Panel Business Mail foundation (Phase 4A).
# Sender profiles are backend-controlled and disabled until explicitly enabled.
# BREVO_API_KEY above remains secret and backend-only; do not commit a value.
BUSINESS_MAIL_PROVIDER=brevo_api
BUSINESS_MAIL_TIMEOUT_MS=15000
BUSINESS_MAIL_MASTER_ADMIN_EMAIL=adminho@orchardgrowers.in
# Process-local Business Mail send limits. Use a shared limiter before horizontal scaling.
BUSINESS_MAIL_ADMIN_WINDOW_MS=600000
BUSINESS_MAIL_ADMIN_MAX_SENDS=10
BUSINESS_MAIL_ADMIN_DAILY_WINDOW_MS=86400000
BUSINESS_MAIL_ADMIN_DAILY_MAX=50
BUSINESS_MAIL_GLOBAL_WINDOW_MS=3600000
BUSINESS_MAIL_GLOBAL_MAX_SENDS=100

BUSINESS_MAIL_EFRUITMANDI_NO_REPLY_ENABLED=false
BUSINESS_MAIL_EFRUITMANDI_NO_REPLY_EMAIL=no-reply@efruitmandi.live
BUSINESS_MAIL_EFRUITMANDI_NO_REPLY_NAME=eFruitMandi
BUSINESS_MAIL_EFRUITMANDI_NO_REPLY_REPLY_TO=support@efruitmandi.live

BUSINESS_MAIL_ORCHARD_NO_REPLY_ENABLED=false
BUSINESS_MAIL_ORCHARD_NO_REPLY_EMAIL=no-reply@orchardgrowers.in
BUSINESS_MAIL_ORCHARD_NO_REPLY_NAME=Orchard Growers
BUSINESS_MAIL_ORCHARD_NO_REPLY_REPLY_TO=support@orchardgrowers.in

BUSINESS_MAIL_EFRUITMANDI_CAREER_ENABLED=false
BUSINESS_MAIL_EFRUITMANDI_CAREER_EMAIL=career@efruitmandi.live
BUSINESS_MAIL_EFRUITMANDI_CAREER_NAME=eFruitMandi Careers
BUSINESS_MAIL_EFRUITMANDI_CAREER_REPLY_TO=career@efruitmandi.live

BUSINESS_MAIL_ORCHARD_CAREER_ENABLED=false
BUSINESS_MAIL_ORCHARD_CAREER_EMAIL=careers@orchardgrowers.in
BUSINESS_MAIL_ORCHARD_CAREER_NAME=Orchard Growers Careers
BUSINESS_MAIL_ORCHARD_CAREER_REPLY_TO=careers@orchardgrowers.in

# Optional official personal/team profiles. Access is granted only when an enabled
# controlled profile email exactly matches the authenticated admin login email.
BUSINESS_MAIL_ADMINHO_ORCHARD_ENABLED=false
BUSINESS_MAIL_ADMINHO_ORCHARD_EMAIL=adminho@orchardgrowers.in
BUSINESS_MAIL_ADMINHO_ORCHARD_NAME=Orchard Growers Administration
BUSINESS_MAIL_ADMINHO_ORCHARD_REPLY_TO=adminho@orchardgrowers.in

BUSINESS_MAIL_SALES_ORCHARD_ENABLED=false
BUSINESS_MAIL_SALES_ORCHARD_EMAIL=sales@orchardgrowers.in
BUSINESS_MAIL_SALES_ORCHARD_NAME=Orchard Growers Sales
BUSINESS_MAIL_SALES_ORCHARD_REPLY_TO=sales@orchardgrowers.in

BUSINESS_MAIL_SUPPORT_EFRUITMANDI_ENABLED=false
BUSINESS_MAIL_SUPPORT_EFRUITMANDI_EMAIL=support@efruitmandi.live
BUSINESS_MAIL_SUPPORT_EFRUITMANDI_NAME=eFruitMandi Support
BUSINESS_MAIL_SUPPORT_EFRUITMANDI_REPLY_TO=support@efruitmandi.live

# SMTP Business Mail uses this complete credential pair when configured.
# Host/port/security may fall back to SMTP_HOST/SMTP_PORT/SMTP_SECURE above.
# Credentials fall back only to a complete SMTP_USER/SMTP_PASS pair and never
# to platform-specific OTP credentials.
BUSINESS_SMTP_HOST=
BUSINESS_SMTP_PORT=587
BUSINESS_SMTP_SECURE=false
BUSINESS_SMTP_USER=
BUSINESS_SMTP_PASS=

ALLOW_TEST_OTP=false
TEST_OTP=
OTP_EXPIRY_MINUTES=5

MOBILE_OTP_PROVIDER=MSG91
USE_LEGACY_MSG91_API=false

ORCHARD_MSG91_AUTH_KEY=
ORCHARD_MSG91_WIDGET_ID=
ORCHARD_MSG91_TEMPLATE_ID=
ORCHARD_MSG91_TOKEN_AUTH=
ORCHARD_MSG91_SENDER_ID=

EFRUITMANDI_MSG91_AUTH_KEY=
EFRUITMANDI_MSG91_WIDGET_ID=
EFRUITMANDI_MSG91_TEMPLATE_ID=
EFRUITMANDI_MSG91_TOKEN_AUTH=
EFRUITMANDI_MSG91_SENDER_ID=

MSG91_OTP_LENGTH=6
MSG91_OTP_EXPIRY_MINUTES=5

TWO_FACTOR_API_KEY=
TWO_FACTOR_TEMPLATE_NAME=

MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=
ORCHARD_RESET_BASE_URL=https://orchardgrowers.in/reset-password
EFRUITMANDI_RESET_BASE_URL=https://efruitmandi.live/reset-password
ADMIN_RESET_BASE_URL=https://admins.orchardgrowers.in/reset-password
# Optional: seed an initial admin on first startup (created only if missing)
ADMIN_SEED_EMAIL=pawann@orchardgrowers.in
ADMIN_SEED_ROLE=superadmin
ADMIN_SEED_STATUS=active

DELHIVERY_API_TOKEN=
INDIA_POST_API_TOKEN=
INDIA_POST_ENABLED=true
INDIA_POST_MODE=sandbox
INDIA_POST_BASE_URL=
INDIA_POST_CLIENT_ID=
INDIA_POST_CLIENT_SECRET=
INDIA_POST_USERNAME=
INDIA_POST_PASSWORD=
INDIA_POST_CUSTOMER_ID=
INDIA_POST_CONTRACT_ID=
INDIA_POST_PICKUP_PINCODE=
INDIA_POST_PICKUP_OFFICE_CODE=
INDIA_POST_API_SUBSCRIPTION_KEY=
INDIA_POST_IP_WHITELISTED=true
PORTER_API_TOKEN=
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
LOGISTICS_MOCK_MODE=false
PLATFORM_COMMISSION_PERCENT=7
PLATFORM_COMMISSION_BPS=700
GROWER_COMMISSION_ENABLED=false
BUYER_COMMISSION_ENABLED=true
GROWER_COMMISSION_BPS=700
BUYER_COMMISSION_BPS=700
EFRUITMANDI_COMMISSION_GST_PERCENT=0

# OG Brain lead collector (backend only)
GOOGLE_PROGRAMMABLE_SEARCH_API_KEY=
GOOGLE_CX_GROWERS=
GOOGLE_CX_BUYERS=
GOOGLE_CX_EXPORTERS=
GOOGLE_CX_MARKETS=
GOOGLE_CX_RESEARCH=
SEARCH_PROVIDER=disabled
# Optional trained object-analysis provider. It must return real categorized
# detections with normalized bounding boxes and versioned visual estimates.
FRUIT_ANALYSIS_PROVIDER_URL=
FRUIT_ANALYSIS_PROVIDER_TOKEN=
FRUIT_ANALYSIS_PROVIDER_TIMEOUT_MS=30000
ORCHARD_AI_COLLECTOR_ENABLED=false
ORCHARD_AI_COLLECTOR_INTERVAL_MINUTES=360
# Optional: attribute automated leads to a specific active admin.
ORCHARD_AI_COLLECTOR_ADMIN_ID=

# Career application mailbox (backend only; manual, read-only IMAP sync)
CAREER_IMAP_HOST=
CAREER_IMAP_PORT=993
CAREER_IMAP_SECURE=true
CAREER_IMAP_USER=
CAREER_IMAP_PASSWORD=
CAREER_IMAP_MAILBOX=INBOX
CAREER_IMAP_REJECT_UNAUTHORIZED=true
CAREER_IMAP_SYNC_LIMIT=100

# eFruitMandi public-profile RSS + LinkedIn Page publishing.
# Feed: https://api.efruitmandi.live/rss/public-profiles.xml
# Keep the access token on the backend only. It needs w_organization_social,
# and its member must be an authorized admin/content admin of the Page.
EFRUITMANDI_PUBLIC_URL=https://www.efruitmandi.live
EFRUITMANDI_DEFAULT_BRAND_IMAGE_URL=https://www.efruitmandi.live/logo-original.png
LINKEDIN_PROFILE_PUBLISHING_ENABLED=false
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_API_VERSION=202606
PROFILE_PUBLISHER_CRON=*/2 * * * *
PROFILE_PUBLISHER_BATCH_SIZE=5
# Extra comma-separated HTTPS hosts allowed for official firm-logo downloads.
PROFILE_PUBLISH_IMAGE_HOSTS=
