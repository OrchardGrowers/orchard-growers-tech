ORCHARD_AI_COLLECTOR_ENABLED=false
ORCHARD_AI_COLLECTOR_INTERVAL_MINUTES=360
# Optional: attribute automated leads to a specific active admin.
ORCHARD_AI_COLLECTOR_ADMIN_ID=

# eFruitMandi public-profile RSS + LinkedIn Page publishing.
# Feed: https://api.efruitmandi.live/rss/public-profiles.xml
# Keep the access token on the backend only. It needs w_organization_social,
# and its member must be an authorized admin/content admin of the Page.
EFRUITMANDI_PUBLIC_URL=https://www.efruitmandi.live
EFRUITMANDI_DEFAULT_BRAND_IMAGE_URL=https://www.efruitmandi.live/logo-original.png
LINKEDIN_PROFILE_PUBLISHING_ENABLED=false
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_API_VERSION=202606
PROFILE_PUBLISHER_CRON=*/2 * * * *
PROFILE_PUBLISHER_BATCH_SIZE=5
# Extra comma-separated HTTPS hosts allowed for official firm-logo downloads.
PROFILE_PUBLISH_IMAGE_HOSTS=
