    "destination": "/faqs/index.html"
  },
  {
    "source": "/privacy-policy",
    "destination": "/privacy-policy/index.html"
  },
  {
    "source": "/terms-of-service",
    "destination": "/terms-of-service/index.html"
  },
  {
    "source": "/refund-cancellation-policy",
    "destination": "/refund-cancellation-policy/index.html"
  },
  {
    "source": "/payment-escrow-policy",
    "destination": "/payment-escrow-policy/index.html"
  },
  {
    "source": "/kyc-verification-policy",
    "destination": "/kyc-verification-policy/index.html"
  },
  {
    "source": "/og-verified-policy",
    "destination": "/og-verified-policy/index.html"
  },
  {
    "source": "/commission-fee-policy",
    "destination": "/commission-fee-policy/index.html"
  },
  {
    "source": "/shipping-logistics-policy",
    "destination": "/shipping-logistics-policy/index.html"
  },
  {
    "source": "/community-guidelines",
    "destination": "/community-guidelines/index.html"
  },
  {
    "source": "/logistics-partner-guide",
    "destination": "/logistics-partner-guide/index.html"
  },
  {
    "source": "/fruit-grading-packing-guidelines",
    "destination": "/fruit-grading-packing-guidelines/index.html"
  },
  {
    "source": "/report-problem",
    "destination": "/report-problem/index.html"
  },
  {
    "source": "/user-data-deletion",
    "destination": "/user-data-deletion/index.html"
  },
  {
    "source": "/mandi-rates",
    "destination": "/mandi-rates/index.html"
  },
  {
    "source": "/mandi-rates/:commoditySlug",
    "destination": "/mandi-rates/:commoditySlug/index.html"
  },
  {
    "source": "/growers",
    "destination": "/growers/index.html"
  },
  {
    "source": "/buyers",
    "destination": "/buyers/index.html"
  },
  {
    "source": "/fruits",
    "destination": "/fruits/index.html"
  },
  {
    "source": "/fruits/:path*",
    "destination": "/fruits/:path*/index.html"
  },
  {
    "source": "/growers/state/:stateSlug/district/:districtSlug",
    "destination": "/growers/state/:stateSlug/district/:districtSlug/index.html"
  },
  {
    "source": "/growers/state/:stateSlug",
    "destination": "/growers/state/:stateSlug/index.html"
  },
  {
    "source": "/buyers/state/:stateSlug/district/:districtSlug",
    "destination": "/buyers/state/:stateSlug/district/:districtSlug/index.html"
  },
  {
    "source": "/buyers/state/:stateSlug",
    "destination": "/buyers/state/:stateSlug/index.html"
  },
  {
    "source": "/growers/:slug",
    "destination": "/growers/:slug/index.html"
  },
  {
    "source": "/buyers/:slug",
    "destination": "/buyers/:slug/index.html"
  },
  {
    "source": "/((?!assets/).*)",
    "destination": "/index.html"
  }
]
}
