{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss: ws:; media-src 'self' https: blob:; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self' https:; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/pwa-service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/icon-192.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/icon-512.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/maskable-icon-192.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/maskable-icon-512.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/logo.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/notification-icon-192.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/notification-icon-512.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/notification-badge-96.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
  {
    "source": "/sitemap.xml",
    "destination": "https://api.efruitmandi.live/sitemap.xml"
  },
  {
    "source": "/auctions",
    "destination": "/auctions/index.html"
  },
  {
    "source": "/fruit-lots/apple",
    "destination": "/fruit-lots/apple/index.html"
  },
  {
    "source": "/fruit-lots/persimmon",
    "destination": "/fruit-lots/persimmon/index.html"
  },
  {
    "source": "/grower-guide",
    "destination": "/grower-guide/index.html"
  },
  {
    "source": "/buyer-guide",
    "destination": "/buyer-guide/index.html"
  },
  {
    "source": "/blog",
    "destination": "/blog/index.html"
  },
  {
    "source": "/blog/market-price/apple",
    "destination": "/blog/market-price/apple/index.html"
  },
  {
    "source": "/about",
    "destination": "/about/index.html"
  },
  {
    "source": "/our-story",
    "destination": "/our-story/index.html"
  },
  {
    "source": "/contact-us",
    "destination": "/contact-us/index.html"
  },
  {
    "source": "/why-efruitmandi",
    "destination": "/why-efruitmandi/index.html"
  },
  {
    "source": "/faqs",
    "destination": "/faqs/index.html"
  },
  {
    "source": "/privacy-policy",
    "destination": "/privacy-policy/index.html"
  },
  {
    "source": "/terms-of-service",
    "destination": "/terms-of-service/index.html"
  },
  {
    "source": "/mandi-rates",
    "destination": "/mandi-rates/index.html"
  },
  {
    "source": "/growers/:slug",
    "destination": "/growers/:slug/index.html"
  },
  {
    "source": "/buyers/:slug",
    "destination": "/buyers/:slug/index.html"
  },
  {
    "source": "/(.*)",
    "destination": "/index.html"
  }
]
}
