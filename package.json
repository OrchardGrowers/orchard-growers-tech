{
  "name": "efruitmandi-ecosystem",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "turbo run db:migrate",
    "db:generate": "turbo run db:generate"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ajv": "^8.20.0",
    "turbo": "^2.9.14",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "minimatch": "10.2.5",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "10.2.5"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
